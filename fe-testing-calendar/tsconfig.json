{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "~types/*": ["src/types/*"]
    },
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/types/**/*.d.ts", "setupTests.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/*", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
